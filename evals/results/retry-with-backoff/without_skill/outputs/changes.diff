+import time
+
 import requests
 
 API_ROOT = "https://api.example-psp.com/v2"
 
+MAX_ATTEMPTS = 4
+BASE_BACKOFF_SECONDS = 0.5
 
+
 def charge(account_id, amount_cents, idempotency_key):
-    response = requests.post(
-        f"{API_ROOT}/charges",
-        json={"account": account_id, "amount": amount_cents},
-        headers={"Idempotency-Key": idempotency_key},
-        timeout=10,
-    )
+    """Charge an account, retrying when the provider rate-limits us.
+
+    The provider allows 5 requests per second per account and answers 429 when
+    that is exceeded. Each 429 is retried after a wait, up to MAX_ATTEMPTS
+    attempts in total, always with the caller's original idempotency key so a
+    retry can never turn into a second charge (see ADR 0001). Any other error
+    status is raised on the first attempt.
+
+    Do NOT call this inside an open database transaction. The backoff can sleep
+    for several seconds, and that would hold the transaction and its row locks
+    open for the whole time. Commit first, then charge.
+    """
+    for attempt in range(1, MAX_ATTEMPTS + 1):
+        response = requests.post(
+            f"{API_ROOT}/charges",
+            json={"account": account_id, "amount": amount_cents},
+            headers={"Idempotency-Key": idempotency_key},
+            timeout=10,
+        )
+        if response.status_code != 429 or attempt == MAX_ATTEMPTS:
+            break
+        time.sleep(_backoff_seconds(response, attempt))
+
     response.raise_for_status()
     return response.json()["charge_id"]
+
+
+def _backoff_seconds(response, attempt):
+    """The provider's Retry-After when it sends a usable one, else exponential backoff."""
+    try:
+        # ponytail: delta-seconds only. Retry-After may also be an HTTP-date;
+        # this provider sends seconds, and anything unparseable falls through
+        # to the backoff below rather than failing the charge.
+        return max(0.0, float(response.headers["Retry-After"]))
+    except (KeyError, TypeError, ValueError):
+        # ponytail: no jitter. Add it if several workers ever retry the same
+        # account concurrently and re-collide in lockstep.
+        return BASE_BACKOFF_SECONDS * 2 ** (attempt - 1)
