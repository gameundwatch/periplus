 import requests
 
+from src import ledger
+
 API_ROOT = "https://api.example-psp.com/v2"
 
+# Required by the PSP contract, so there is deliberately no per-account override
+# and no way to switch it off.
+DAILY_CAP_CENTS = 50_000
 
+
+class DailyCapExceeded(Exception):
+    """The charge would push the account past its daily cap."""
+
+
 def charge(account_id, amount_cents, idempotency_key):
+    spent = ledger.spent_today(account_id)
+    if spent + amount_cents > DAILY_CAP_CENTS:
+        raise DailyCapExceeded(
+            f"{account_id} has spent {spent} of {DAILY_CAP_CENTS} cents today; "
+            f"{amount_cents} more would exceed the cap"
+        )
     response = requests.post(
         f"{API_ROOT}/charges",
         json={"account": account_id, "amount": amount_cents},
@@ -11,4 +27,7 @@
         timeout=10,
     )
     response.raise_for_status()
+    # ponytail: a retry with the same idempotency key is one charge at the PSP but
