+++ evals/results/per-account-daily-cap/with_skill/repo/src/ledger.py	2026-07-29 21:55:21
@@ -0,0 +1,22 @@
+from collections import defaultdict
+from datetime import datetime, timezone
+
+# ponytail: totals live in this process only, so each worker enforces the cap
+# against its own view of the day. Read-then-write is unlocked: two concurrent
+# charges for one account can both see the pre-charge total and both pass.
+# Keys are never evicted, so this grows for the lifetime of the process.
+_spent_cents = defaultdict(int)
+
+
+def _today():
+    # The PSP contract counts a calendar day. UTC is the only day boundary both
+    # sides agree on without knowing where the account is.
+    return datetime.now(timezone.utc).date()
+
+
+def spent_today(account_id):
+    return _spent_cents[(account_id, _today())]
+
+
+def record(account_id, amount_cents):
+    _spent_cents[(account_id, _today())] += amount_cents
