 import requests
 
+from src import ledger
+
 API_ROOT = "https://api.example-psp.com/v2"
 
+# Fixed by the PSP contract. This is a compliance limit rather than a product
+# rule, so there is no per-account override and no way to turn it off.
+DAILY_CAP_CENTS = 50_000
 
+
+class DailyCapExceeded(Exception):
+    pass
+
+
 def charge(account_id, amount_cents, idempotency_key):
+    if ledger.spent_today(account_id) + amount_cents > DAILY_CAP_CENTS:
+        raise DailyCapExceeded(
+            f"{account_id} would exceed the {DAILY_CAP_CENTS} cent daily cap"
+        )
     response = requests.post(
         f"{API_ROOT}/charges",
         json={"account": account_id, "amount": amount_cents},
@@ -11,4 +25,7 @@
         timeout=10,
     )
     response.raise_for_status()
+    # Only settled charges count against the cap. A retry carrying the same
+    # idempotency key is one charge to the PSP but two to the ledger.
+    ledger.record(account_id, amount_cents)
     return response.json()["charge_id"]
